# Dev: Vite proxy target (browser still uses /api). Do not use https URL locally unless you skip the proxy.
VITE_API_URL=http://127.0.0.1:8000

# Vercel production: set VITE_API_URL=https://bookme-ai-api.onrender.com (no trailing slash)

# Production Clerk (matches API AUTH_DISABLED=0)
VITE_AUTH_DISABLED=false
VITE_CLERK_PUBLISHABLE_KEY=

# Dev bypass (matches API AUTH_DISABLED=1):
# VITE_AUTH_DISABLED=true
# VITE_DEV_USER_ID=dev-user
