# =============================================================================
# TripWeaver — environment variables (copy to .env and fill in)
# NEVER commit the real .env. Only .env.example is tracked.
# =============================================================================

# ── LLM provider keys ─────────────────────────────────────────────────────────
# The active provider is chosen in config/params.yaml (provider.default).
# Out of the box that is "openai", so only OPENAI_API_KEY is required.
OPENAI_API_KEY=sk-your-openai-key-here

# Optional — enable these to switch provider in params.yaml, or to power the
# cross-provider LLM fallback chain (graceful degradation on provider outage).
# OPENROUTER_API_KEY=sk-or-your-openrouter-key
# GROQ_API_KEY=gsk_your-groq-key

# ── Observability (LangFuse tracing + Prompt Management) ───────────────────────
# Tracing: observability.enabled: true in config/params.yaml
# Prompts: LANGFUSE_PROMPTS=true  (recommended — edit prompts in UI, no redeploy)
#          optional: observability.prompts_enabled: true in params.yaml instead
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PROMPTS=true

# ── Frontend → backend URL (used by the Gradio app) ───────────────────────────
TRIPWEAVER_API_URL=http://127.0.0.1:8000
