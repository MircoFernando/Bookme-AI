# =============================================================================
# BookMe AI — environment variables (copy to .env and fill in)
# NEVER commit the real .env. Only .env.example is tracked.
# =============================================================================

# ── LLM provider keys ─────────────────────────────────────────────────────────
# Router, guardrail, chat agents: OPENAI_API_KEY + openai.* in models.yaml.
# Multi-route merge: GOOGLE_API_KEY + google.merge.* in models.yaml.
OPENAI_API_KEY=sk-your-openai-key-here
GOOGLE_API_KEY=your-gemini-api-key

# Optional — cross-provider fallback or alternate llm.roles in params.yaml
# OPENROUTER_API_KEY=sk-or-your-openrouter-key
# GROQ_API_KEY=gsk_your-groq-key

# ── Observability (LangFuse tracing + Prompt Management) ───────────────────────
# Tracing: observability.enabled: true in config/params.yaml
# Prompts: LANGFUSE_PROMPTS=true  (recommended — edit prompts in UI, no redeploy)
#          optional: observability.prompts_enabled: true in params.yaml instead
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PROMPTS=true

# ── Frontend → backend URL (used by the Gradio app) ───────────────────────────
BOOKME_AI_API_URL=http://127.0.0.1:8000

# ── Tavily web search (web_search MCP agent — tourism / destination advice) ───
TAVILY_API_KEY=tvly-your-tavily-key-here
